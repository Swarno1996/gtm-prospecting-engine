    {
      "parameters": {
        "jsCode": "// Map a Dialfire webhook task payload onto the engine's call outcome contract.\n// Dialfire sends the contact's campaign fields. crm_contact_id is one of them because\n// the engine writes it when it loads the contact. The status values are defined per\n// campaign: edit STATUS_MAP to match yours, then check against a real execution.\nconst STATUS_MAP = {\n  success: 'meeting_booked', termin: 'meeting_booked',\n  declined: 'not_interested', kein_interesse: 'not_interested',\n  no_answer: 'no_answer', nicht_erreicht: 'no_answer',\n  callback: 'callback', wiedervorlage: 'callback',\n  wrong_number: 'wrong_number', falsche_nummer: 'wrong_number',\n  dnc: 'do_not_call', sperre: 'do_not_call',\n};\nconst b = $input.first().json.body || {};\nconst status = String(b.$status || b.status || '').toLowerCase();\nconst outcome = STATUS_MAP[status];\nif (!b.crm_contact_id || !outcome) {\n  throw new Error(`Call outcome contract broken: crm_contact_id=${b.crm_contact_id} status=${status}`);\n}\nreturn [{ json: {\n  crm_contact_id: String(b.crm_contact_id),\n  outcome,\n  call_id: String(b.$call_id || b.call_id || b.$id || ''),\n  callback_at: b.callback_at || '',\n  notes: b.notes || b.comment || '',\n  agent: b.$user || b.agent || '',\n}}];"
      },
      "id": "9fdbf381-c0f1-583c-ba57-2a763577a7ae",
      "name": "Map Dialfire fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.engineUrl }}/call-outcome",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 300000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "id": "b4cd505c-5b69-54ac-98fd-a9e10f39c3bb",
      "name": "Write outcome to CRM",
      "type": "n8n-nodes-base.httpRequest",
